# Supabase (public client configuration)
VITE_SUPABASE_URL=https://uexoawamkxiqfjsytwof.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_DwxxVNc5Kc0xOYuLAFJ27Q_06deWmjU

# Optional: free key from openrouteservice.org for road routes on the tracking map.
# Without it the app uses the free OSRM server instead.
VITE_ORS_API_KEY=

# Production Site URL (set this in your deployment platform, e.g. Vercel)
VITE_SITE_URL=http://localhost:5173

# Optional: Customer Support Contact (read by Help & Support modal)
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_HOURS=

# Allowed Origins for Serverless Speech API (comma-separated)
ALLOWED_ORIGINS=https://harvestrent.vercel.app,http://localhost:5173

# ElevenLabs Text-to-Speech API (Server-side secret, set in Vercel Dashboard / .env.local)
# Do NOT prefix with VITE_ or expose to the client browser
ELEVENLABS_API_KEY=

# Optional ElevenLabs configuration overrides
# Default model: eleven_multilingual_v2 supports en, hi, ta but NOT Kannada (kn).
# For Kannada, set this to a model that supports it (verify in ElevenLabs docs).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Specific voice IDs (defaulting to configured voice LHMvGhXWZPfzCiDpiEc1)
ELEVENLABS_VOICE_ID=LHMvGhXWZPfzCiDpiEc1
ELEVENLABS_VOICE_EN=LHMvGhXWZPfzCiDpiEc1
ELEVENLABS_VOICE_HI=LHMvGhXWZPfzCiDpiEc1
ELEVENLABS_VOICE_KN=LHMvGhXWZPfzCiDpiEc1
ELEVENLABS_VOICE_TA=LHMvGhXWZPfzCiDpiEc1
